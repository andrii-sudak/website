{{- /*
  Hugo Content Adapter for Multi-Source Syndication (Mastodon, Pixelfed & DEV.to)
  -------------------------------------------------------------------------------
  Dynamically generates native Hugo pages in /posts/ from:
    1. Mastodon: optional data/mastodon/archive.json + live [params.mastodon] API
    2. Pixelfed: optional data/pixelfed/archive.json + live [params.pixelfed] API
    3. DEV.to:   optional data/devto/archive.json    + live [params.devto] API

  Uses "mastodon-<id>", "pixelfed-<id>", and "devto-<id>" path namespaces so
  syndicated posts never conflict with manual Markdown posts or each other.
*/ -}}

{{- $mastoInstance := site.Params.mastodon.instance | default "https://infosec.exchange" | strings.TrimRight "/" -}}
{{- $mastoAccountId := site.Params.mastodon.accountId | default "113526667200388301" -}}
{{- $mastoUsername := site.Params.mastodon.username | default "andrii_sudak" -}}
{{- $mastoHost := replaceRE "^https?://" "" $mastoInstance -}}

{{- $pfInstance := site.Params.pixelfed.instance | default "https://fotolibre.social" | strings.TrimRight "/" -}}
{{- $pfAccountId := site.Params.pixelfed.accountId | default "958983952396242093" -}}
{{- $pfUsername := site.Params.pixelfed.username | default "andrii-sudak" -}}
{{- $pfHost := replaceRE "^https?://" "" $pfInstance -}}

{{- $devtoInstance := site.Params.devto.instance | default "https://dev.to" | strings.TrimRight "/" -}}
{{- $devtoAccountId := site.Params.devto.accountId | default "1250384" -}}
{{- $devtoUsername := site.Params.devto.username | default "andrii-sudak" -}}
{{- $devtoHost := replaceRE "^https?://" "" $devtoInstance -}}

{{- $entries := slice -}}
{{- $seenKeys := dict -}}

{{- /* 1A. Load Mastodon local archive (data/mastodon/archive.json) if present */ -}}
{{- with hugo.Data.mastodon -}}
  {{- with .archive -}}
    {{- range . -}}
      {{- $key := printf "mastodon-%v" .id -}}
      {{- if not (index $seenKeys $key) -}}
        {{- $seenKeys = merge $seenKeys (dict $key true) -}}
        {{- $entries = $entries | append (dict
          "source" "mastodon"
          "category" "Mastodon"
          "instance" $mastoInstance
          "host" $mastoHost
          "username" $mastoUsername
          "accountId" $mastoAccountId
          "status" .
        ) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 1B. Fetch live public Mastodon statuses (up to 5 pages x 40 items) */ -}}
{{- $maxId := "" -}}
{{- $keepFetching := true -}}
{{- range seq 1 5 -}}
  {{- if $keepFetching -}}
    {{- $apiURL := printf "%s/api/v1/accounts/%s/statuses?exclude_replies=true&exclude_reblogs=true&limit=40" $mastoInstance $mastoAccountId -}}
    {{- if ne $maxId "" -}}
      {{- $apiURL = printf "%s&max_id=%s" $apiURL $maxId -}}
    {{- end -}}
    {{- with try (resources.GetRemote $apiURL) -}}
      {{- with .Err -}}
        {{- warnf "Mastodon content adapter: failed to fetch %s: %s" $apiURL . -}}
        {{- $keepFetching = false -}}
      {{- else with .Value -}}
        {{- $pageStatuses := . | transform.Unmarshal -}}
        {{- if gt (len $pageStatuses) 0 -}}
          {{- range $pageStatuses -}}
            {{- $id := printf "%v" .id -}}
            {{- $maxId = $id -}}
            {{- $key := printf "mastodon-%s" $id -}}
            {{- if not (index $seenKeys $key) -}}
              {{- $seenKeys = merge $seenKeys (dict $key true) -}}
              {{- $entries = $entries | append (dict
                "source" "mastodon"
                "category" "Mastodon"
                "instance" $mastoInstance
                "host" $mastoHost
                "username" $mastoUsername
                "accountId" $mastoAccountId
                "status" .
              ) -}}
            {{- end -}}
          {{- end -}}
          {{- if lt (len $pageStatuses) 40 -}}
            {{- $keepFetching = false -}}
          {{- end -}}
        {{- else -}}
          {{- $keepFetching = false -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 2A. Load Pixelfed local archive (data/pixelfed/archive.json) if present */ -}}
{{- with hugo.Data.pixelfed -}}
  {{- with .archive -}}
    {{- range . -}}
      {{- $key := printf "pixelfed-%v" .id -}}
      {{- if not (index $seenKeys $key) -}}
        {{- $seenKeys = merge $seenKeys (dict $key true) -}}
        {{- $entries = $entries | append (dict
          "source" "pixelfed"
          "category" "Pixelfed"
          "instance" $pfInstance
          "host" $pfHost
          "username" $pfUsername
          "accountId" $pfAccountId
          "status" .
        ) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 2B. Fetch live public Pixelfed statuses */ -}}
{{- $pfMaxId := "" -}}
{{- $pfKeepFetching := true -}}
{{- range seq 1 5 -}}
  {{- if $pfKeepFetching -}}
    {{- $pfURL := printf "%s/api/pixelfed/v1/accounts/%s/statuses?only_media=true" $pfInstance $pfAccountId -}}
    {{- if ne $pfMaxId "" -}}
      {{- $pfURL = printf "%s&max_id=%s" $pfURL $pfMaxId -}}
    {{- end -}}
    {{- with try (resources.GetRemote $pfURL) -}}
      {{- with .Err -}}
        {{- warnf "Pixelfed content adapter: failed to fetch %s: %s" $pfURL . -}}
        {{- $pfKeepFetching = false -}}
      {{- else with .Value -}}
        {{- $pfStatuses := . | transform.Unmarshal -}}
        {{- if gt (len $pfStatuses) 0 -}}
          {{- range $pfStatuses -}}
            {{- $id := printf "%v" .id -}}
            {{- $pfMaxId = $id -}}
            {{- $key := printf "pixelfed-%s" $id -}}
            {{- if not (index $seenKeys $key) -}}
              {{- $seenKeys = merge $seenKeys (dict $key true) -}}
              {{- $entries = $entries | append (dict
                "source" "pixelfed"
                "category" "Pixelfed"
                "instance" $pfInstance
                "host" $pfHost
                "username" $pfUsername
                "accountId" $pfAccountId
                "status" .
              ) -}}
            {{- end -}}
          {{- end -}}
          {{- if lt (len $pfStatuses) 9 -}}
            {{- $pfKeepFetching = false -}}
          {{- end -}}
        {{- else -}}
          {{- $pfKeepFetching = false -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 3. Filter Fediverse statuses to own root public posts and count posts per calendar day */ -}}
{{- $rootEntries := slice -}}
{{- $dateCounts := dict -}}
{{- range $entry := $entries -}}
  {{- $s := $entry.status -}}
  {{- $isPublic := eq $s.visibility "public" -}}
  {{- $isNotReblog := not $s.reblog -}}
  {{- $isNotReply := not $s.in_reply_to_id -}}
  {{- if and $isPublic $isNotReblog $isNotReply -}}
    {{- $rootEntries = $rootEntries | append $entry -}}
    {{- $createdAt := time.AsTime $s.created_at -}}
    {{- $dayKey := $createdAt.Format "2006-01-02" -}}
    {{- $currentCount := index $dateCounts $dayKey | default 0 -}}
    {{- $dateCounts = merge $dateCounts (dict $dayKey (add $currentCount 1)) -}}
  {{- end -}}
{{- end -}}

{{- /* 4. Register each Fediverse status as a native Hugo page */ -}}
{{- range $entry := $rootEntries -}}
  {{- $status := $entry.status -}}
  {{- $source := $entry.source -}}
  {{- $category := $entry.category -}}
  {{- $instance := $entry.instance -}}
  {{- $host := $entry.host -}}
  {{- $username := $entry.username -}}
  {{- $accountId := $entry.accountId -}}

  {{- $id := printf "%v" $status.id -}}
  {{- $createdAt := time.AsTime $status.created_at -}}
  {{- $lastmod := $createdAt -}}
  {{- with $status.edited_at -}}
    {{- $lastmod = time.AsTime . -}}
  {{- end -}}

  {{- $dayKey := $createdAt.Format "2006-01-02" -}}
  {{- $title := $dayKey -}}
  {{- if gt (index $dateCounts $dayKey | default 1) 1 -}}
    {{- $title = $createdAt.Format "2006-01-02 · 15:04" -}}
  {{- end -}}

  {{- /* Extract hashtags into native Hugo tags */ -}}
  {{- $tags := slice -}}
  {{- range $status.tags -}}
    {{- with .name -}}
      {{- $tags = $tags | append . -}}
    {{- end -}}
  {{- end -}}

  {{- /* Build clean preview HTML and plain-text summary (stripping trailing hashtag-only paragraphs) */ -}}
  {{- $rawContent := $status.content | default "" -}}
  {{- $summaryHTML := replaceRE `<p>(\s*<a[^>]*class="[^"]*hashtag[^"]*"[^>]*>#<span>[^<]+</span></a>\s*)+</p>\s*$` "" $rawContent -}}
  {{- $summaryText := $summaryHTML | plainify | htmlUnescape | strings.TrimSpace -}}
  {{- if eq $summaryText "" -}}
    {{- $summaryHTML = $rawContent -}}
    {{- $summaryText = $rawContent | plainify | htmlUnescape | strings.TrimSpace -}}
  {{- end -}}

  {{- /* Build post HTML body + attached media + extract preview thumbnail if present */ -}}
  {{- $bodyHTML := "" -}}
  {{- if ne (strings.TrimSpace $rawContent) "" -}}
    {{- $bodyHTML = printf `<div class="mastodon-post-content">%s</div>` $rawContent -}}
  {{- end -}}
  {{- $featureImageURL := "" -}}

  {{- with $status.media_attachments -}}
    {{- if gt (len .) 0 -}}
      {{- $mediaItems := "" -}}
      {{- range . -}}
        {{- if eq $featureImageURL "" -}}
          {{- if eq .type "image" -}}
            {{- $featureImageURL = .preview_url | default .url -}}
          {{- else if or (eq .type "gifv") (eq .type "video") -}}
            {{- $featureImageURL = .preview_url | default "" -}}
          {{- end -}}
        {{- end -}}
        {{- $desc := .description | default (printf "Attached media from %s" $category) | htmlEscape -}}
        {{- if eq .type "image" -}}
          {{- $mediaItems = printf `%s<figure class="mastodon-media-item my-4"><a href="%s" target="_blank" rel="noopener noreferrer"><img src="%s" alt="%s" loading="lazy" decoding="async" class="rounded-lg max-h-[600px] w-auto mx-auto" /></a></figure>` $mediaItems .url .url $desc -}}
        {{- else if or (eq .type "gifv") (eq .type "video") -}}
          {{- $loopAttr := cond (eq .type "gifv") "autoplay loop muted playsinline" "playsinline" -}}
          {{- $mediaItems = printf `%s<figure class="mastodon-media-item my-4"><video src="%s" %s controls preload="metadata" aria-label="%s" class="rounded-lg max-h-[600px] w-auto mx-auto"></video></figure>` $mediaItems .url $loopAttr $desc -}}
        {{- else if eq .type "audio" -}}
          {{- $mediaItems = printf `%s<figure class="mastodon-media-item my-4"><audio src="%s" controls preload="metadata" class="w-full"></audio></figure>` $mediaItems .url -}}
        {{- end -}}
      {{- end -}}
      {{- if ne $mediaItems "" -}}
        {{- $bodyHTML = printf "%s\n<div class=\"mastodon-media-gallery my-6\">%s</div>" $bodyHTML $mediaItems -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $defaultPostURL := cond (eq $source "pixelfed") (printf "%s/p/%s/%s" $instance $username $id) (printf "%s/@%s/%s" $instance $username $id) -}}
  {{- $postURL := $status.url | default $defaultPostURL -}}
  {{- $hasFeatureImage := ne $featureImageURL "" -}}
  {{- $repliesCount := $status.replies_count | default ($status.reply_count | default 0) -}}
  {{- $initialRepliesJSON := "[]" -}}
  {{- with $status.replies -}}
    {{- $initialRepliesJSON = . | jsonify -}}
  {{- end -}}

  {{- $params := dict
    "source" $source
    "summary" $summaryText
    "previewHTML" $summaryHTML
    "featureimage" $featureImageURL
    "hideFeatureImage" (not $hasFeatureImage)
    "showAuthor" false
    "showAuthorBottom" true
    "showDate" (eq ($createdAt.Format "2006-01-02") ($lastmod.Format "2006-01-02"))
    "showDateOnlyInArticle" true
    "showDateUpdated" true
    "showTaxonomies" false
    "categories" (slice $category)
    "tags" $tags
    "mastodon" (dict
      "source" $source
      "instance" $instance
      "host" $host
      "username" $username
      "accountId" $accountId
      "id" $id
      "url" $postURL
      "replies_count" $repliesCount
      "reblogs_count" ($status.reblogs_count | default 0)
      "favourites_count" ($status.favourites_count | default 0)
      "initial_replies" $initialRepliesJSON
    )
  -}}

  {{- $page := dict
    "kind" "page"
    "path" (printf "%s-%s" $source $id)
    "title" $title
    "dates" (dict
      "date" $createdAt
      "publishDate" $createdAt
      "lastmod" $lastmod
    )
    "params" $params
    "content" (dict
      "mediaType" "text/markdown"
      "value" $bodyHTML
    )
  -}}
  {{- $.AddPage $page -}}
{{- end -}}

{{- /* 5A. Load DEV.to local archive (data/devto/archive.json) if present */ -}}
{{- $devtoArticles := slice -}}
{{- with hugo.Data.devto -}}
  {{- with .archive -}}
    {{- range . -}}
      {{- $key := printf "devto-%d" (int .id) -}}
      {{- if not (index $seenKeys $key) -}}
        {{- $seenKeys = merge $seenKeys (dict $key true) -}}
        {{- $devtoArticles = $devtoArticles | append . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 5B. Fetch live public DEV.to articles + full body for each article */ -}}
{{- $devtoListURL := printf "%s/api/articles?username=%s&per_page=100" $devtoInstance $devtoUsername -}}
{{- with try (resources.GetRemote $devtoListURL) -}}
  {{- with .Err -}}
    {{- warnf "DEV.to content adapter: failed to fetch %s: %s" $devtoListURL . -}}
  {{- else with .Value -}}
    {{- $listItems := . | transform.Unmarshal -}}
    {{- range $item := $listItems -}}
      {{- $id := printf "%d" (int $item.id) -}}
      {{- $key := printf "devto-%s" $id -}}
      {{- if not (index $seenKeys $key) -}}
        {{- $seenKeys = merge $seenKeys (dict $key true) -}}
        {{- $detailURL := printf "%s/api/articles/%s" $devtoInstance $id -}}
        {{- with try (resources.GetRemote $detailURL) -}}
          {{- with .Err -}}
            {{- warnf "DEV.to content adapter: failed to fetch detail %s: %s" $detailURL . -}}
            {{- $devtoArticles = $devtoArticles | append $item -}}
          {{- else with .Value -}}
            {{- $fullArticle := . | transform.Unmarshal -}}
            {{- $devtoArticles = $devtoArticles | append $fullArticle -}}
          {{- else -}}
            {{- $devtoArticles = $devtoArticles | append $item -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* 5C. Register each DEV.to article as a native Hugo page */ -}}
{{- range $article := $devtoArticles -}}
  {{- $id := printf "%d" (int $article.id) -}}
  {{- $publishedStr := $article.published_at | default $article.created_at -}}
  {{- $createdAt := time.AsTime $publishedStr -}}
  {{- $lastmod := $createdAt -}}
  {{- with $article.edited_at -}}
    {{- $lastmod = time.AsTime . -}}
  {{- end -}}

  {{- $title := $article.title | default ($createdAt.Format "2006-01-02") -}}

  {{- /* Extract tags (handling both slice and comma-separated string formats) */ -}}
  {{- $tags := slice -}}
  {{- if reflect.IsSlice $article.tags -}}
    {{- range $article.tags -}}
      {{- $tags = $tags | append (printf "%v" .) -}}
    {{- end -}}
  {{- else if reflect.IsSlice $article.tag_list -}}
    {{- range $article.tag_list -}}
      {{- $tags = $tags | append (printf "%v" .) -}}
    {{- end -}}
  {{- else if $article.tag_list -}}
    {{- range (split (printf "%v" $article.tag_list) ",") -}}
      {{- $t := strings.TrimSpace . -}}
      {{- if ne $t "" -}}
        {{- $tags = $tags | append $t -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $rawBody := $article.body_html | default "" -}}
  {{- $featureImageURL := $article.cover_image | default "" -}}
  {{- if eq $featureImageURL "" -}}
    {{- $imgMatches := findRESubmatch `<img[^>]+src="([^"]+)"` $rawBody 1 -}}
    {{- if gt (len $imgMatches) 0 -}}
      {{- $firstMatch := index $imgMatches 0 -}}
      {{- if gt (len $firstMatch) 1 -}}
        {{- $featureImageURL = index $firstMatch 1 -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* Strip inline images from card summary preview so text clamps cleanly */ -}}
  {{- $cleanPreview := replaceRE `(?s)<a[^>]*class="[^"]*article-body-image-wrapper[^"]*"[^>]*>.*?</a>` "" $rawBody -}}
  {{- $cleanPreview = replaceRE `<img[^>]*>` "" $cleanPreview -}}
  {{- $cleanPreview = replaceRE `(<br\s*/?>\s*)+` " " $cleanPreview -}}
  {{- $summaryText := $cleanPreview | plainify | htmlUnescape | strings.TrimSpace -}}
  {{- if eq $summaryText "" -}}
    {{- $summaryText = $article.description | default "" -}}
    {{- $cleanPreview = printf "<p>%s</p>" ($summaryText | htmlEscape) -}}
  {{- end -}}

  {{- $bodyHTML := printf `<div class="mastodon-post-content devto-article-content">%s</div>` $rawBody -}}
  {{- $postURL := $article.url | default (printf "%s/%s/%s" $devtoInstance $devtoUsername $id) -}}
  {{- $hasFeatureImage := ne $featureImageURL "" -}}
  {{- $commentsCount := $article.comments_count | default 0 -}}
  {{- /* comments_count includes comments hidden by the author; count only visible ones */ -}}
  {{- $commentsURL := printf "%s/api/comments?a_id=%s" $devtoInstance $id -}}
  {{- with try (resources.GetRemote $commentsURL) -}}
    {{- with .Value -}}
      {{- $tree := . | transform.Unmarshal -}}
      {{- $commentsCount = len (findRE `"id_code"` (jsonify $tree)) -}}
    {{- end -}}
  {{- end -}}
  {{- $reactionsCount := $article.public_reactions_count | default ($article.positive_reactions_count | default 0) -}}

  {{- $params := dict
    "source" "devto"
    "summary" $summaryText
    "previewHTML" $cleanPreview
    "featureimage" $featureImageURL
    "hideFeatureImage" (not $hasFeatureImage)
    "showAuthor" false
    "showAuthorBottom" true
    "showDate" (eq ($createdAt.Format "2006-01-02") ($lastmod.Format "2006-01-02"))
    "showDateOnlyInArticle" false
    "showDateUpdated" true
    "showTaxonomies" false
    "categories" (slice "DEV.to")
    "tags" $tags
    "mastodon" (dict
      "source" "devto"
      "instance" $devtoInstance
      "host" $devtoHost
      "username" $devtoUsername
      "accountId" $devtoAccountId
      "id" $id
      "url" $postURL
      "replies_count" $commentsCount
      "reblogs_count" 0
      "favourites_count" $reactionsCount
      "initial_replies" "[]"
    )
  -}}

  {{- $page := dict
    "kind" "page"
    "path" (printf "devto-%s" $id)
    "title" $title
    "dates" (dict
      "date" $createdAt
      "publishDate" $createdAt
      "lastmod" $lastmod
    )
    "params" $params
    "content" (dict
      "mediaType" "text/markdown"
      "value" $bodyHTML
    )
  -}}
  {{- $.AddPage $page -}}
{{- end -}}
